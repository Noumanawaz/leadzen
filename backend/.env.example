# Nest API
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Neon Postgres — use the pooled connection string for the app runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Neon direct (non-pooled) connection — used by Prisma migrate
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth (change in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis (docker compose)
REDIS_URL=redis://localhost:6379

# Platform admin allowlist (comma-separated emails). Empty = no auto-bootstrap.
ADMIN_EMAIL_ALLOWLIST=demo@leads.test

# Encryption key for connected-account tokens (32-byte base64)
TOKEN_ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_GRACE_PERIOD_DAYS=3

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/callback

# Groq AI (optional — stub responses when empty)
# llama-3.1-8b-instant retired Aug 2026 → openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Places API (New) — platform-managed key for Find Leads
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=true

# Meta WhatsApp Cloud API (Embedded Signup + webhooks)
# OUR META APP credentials — server-only, never tenant-scoped
META_APP_ID=
META_APP_SECRET=
# From Meta app → Facebook Login for Business → Embedded Signup → Configuration ID
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v22.0
# Optional / unused for tenant Embedded Signup today
META_SYSTEM_USER_TOKEN=

# TENANT WhatsApp access tokens are stored encrypted in connected_accounts — not here

# Hardening
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SENTRY_DSN=
OTEL_ENABLED=false
DATA_RETENTION_DAYS=365
