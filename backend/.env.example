# =============================================================================
# LeadZen backend — copy into Render → Environment (bulk import) or backend/.env
# Generate secrets: openssl rand -base64 32
# =============================================================================
#
# Production URLs (reference)
#   API:      https://leadzen-ebo2.onrender.com
#   Health:   https://leadzen-ebo2.onrender.com/api/health
#   Webhook:  https://leadzen-ebo2.onrender.com/api/webhooks/whatsapp
#   Frontend: https://frontend-gray-two-sxhyv0kdcz.vercel.app
#
# Local dev: set NODE_ENV=development, FRONTEND_URL=http://localhost:3000,
#   GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/callback
# =============================================================================

NODE_ENV=production
PORT=4000
FRONTEND_URL=https://frontend-gray-two-sxhyv0kdcz.vercel.app

# Neon Postgres — pooled URL for runtime; direct URL for Prisma migrate
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

JWT_ACCESS_SECRET=REPLACE_ME_OPENSSL_RAND_BASE64_32
JWT_REFRESH_SECRET=REPLACE_ME_OPENSSL_RAND_BASE64_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional — webhooks process inline if Redis unavailable
REDIS_URL=redis://localhost:6379

ADMIN_EMAIL_ALLOWLIST=demo@leads.test

# Required for WhatsApp/Gmail token encryption (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=REPLACE_ME_OPENSSL_RAND_BASE64_32

# Stripe (test or live)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_GRACE_PERIOD_DAYS=3

# Google OAuth (Gmail) — add authorized redirect in Google Cloud Console
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://leadzen-ebo2.onrender.com/api/v1/integrations/gmail/callback

# Groq AI (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Places API (optional — Find Leads)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=true

# Meta WhatsApp — server-only; tenant tokens live in connected_accounts
META_APP_ID=2293904991444326
META_APP_SECRET=REPLACE_ME_FROM_META_APP_DASHBOARD
META_EMBEDDED_SIGNUP_CONFIG_ID=1808309997004432
META_WEBHOOK_VERIFY_TOKEN=leadzen_wa_verify_2026
META_GRAPH_API_VERSION=v22.0
META_SYSTEM_USER_TOKEN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SENTRY_DSN=
OTEL_ENABLED=false
DATA_RETENTION_DAYS=365
