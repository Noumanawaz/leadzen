enum SequenceStatus {
  draft
  active
  paused
  archived
}

enum SequenceStepChannel {
  email
  whatsapp
  sms
  call
  wait
}

enum SequenceCondition {
  none
  opened
  clicked
  replied
  bounced
  lead_score_gte
  status_equals
  has_tag
}

enum EnrollmentStatus {
  active
  completed
  stopped
  paused
  failed
}

enum AutomationTrigger {
  lead_created
  lead_updated
  lead_stage_changed
  lead_score_changed
  email_replied
  meeting_booked
  task_completed
}

model Sequence {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  status         SequenceStatus @default(draft)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        SequenceStep[]
  enrollments  SequenceEnrollment[]
  campaigns    Campaign[]

  @@index([organizationId, status])
  @@map("sequences")
}

model SequenceStep {
  id             String              @id @default(cuid())
  sequenceId     String              @map("sequence_id")
  position       Int
  channel        SequenceStepChannel
  delayDays      Int                 @default(0) @map("delay_days")
  subject        String?
  body           String?
  condition      SequenceCondition   @default(none)
  conditionValue String?             @map("condition_value")
  yesNextStepId  String?             @map("yes_next_step_id")
  noNextStepId   String?             @map("no_next_step_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  sequence    Sequence             @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  enrollments SequenceEnrollment[]

  @@index([sequenceId, position])
  @@map("sequence_steps")
}

model SequenceEnrollment {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  sequenceId     String           @map("sequence_id")
  leadId         String           @map("lead_id")
  currentStepId  String?          @map("current_step_id")
  status         EnrollmentStatus @default(active)
  nextRunAt      DateTime?        @map("next_run_at")
  stoppedReason  String?          @map("stopped_reason")
  lastError      String?          @map("last_error")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  sequence    Sequence      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  currentStep SequenceStep? @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, leadId])
  @@index([organizationId, status, nextRunAt])
  @@map("sequence_enrollments")
}

model Campaign {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  sequenceId     String?  @map("sequence_id")
  name           String
  sent           Int      @default(0)
  delivered      Int      @default(0)
  opened         Int      @default(0)
  clicked        Int      @default(0)
  replied        Int      @default(0)
  bounced        Int      @default(0)
  unsubscribed   Int      @default(0)
  meetings       Int      @default(0)
  won            Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequence     Sequence?    @relation(fields: [sequenceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("campaigns")
}

model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  name           String
  trigger        AutomationTrigger
  isActive       Boolean           @default(true) @map("is_active")
  conditions     Json              @default("[]")
  actions        Json              @default("[]")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, trigger, isActive])
  @@map("automation_rules")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id             String   @id @default(cuid())
  featureFlagId  String   @map("feature_flag_id")
  organizationId String   @map("organization_id")
  enabled        Boolean
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  featureFlag  FeatureFlag  @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, organizationId])
  @@index([organizationId])
  @@map("feature_flag_overrides")
}

enum PrivacyRequestType {
  export
  delete
}

enum PrivacyRequestStatus {
  pending
  processing
  completed
  failed
}

model PrivacyRequest {
  id               String               @id @default(cuid())
  organizationId   String               @map("organization_id")
  type             PrivacyRequestType
  status           PrivacyRequestStatus @default(pending)
  subjectEmail     String?              @map("subject_email")
  requestedByUserId String?             @map("requested_by_user_id")
  resultPayload    Json?                @map("result_payload")
  error            String?
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@map("privacy_requests")
}

enum LeadSourceType {
  apollo
  google_places
  csv
  website_form
  referral
  api
  manual
  other
}

enum LeadSourceStatus {
  active
  paused
  archived
}

enum LeadImportStatus {
  pending
  mapping
  queued
  processing
  completed
  failed
  cancelled
}

enum DuplicatePolicy {
  skip
  merge
  update
  create
}

model LeadSource {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  type            LeadSourceType
  name            String
  integrationId   String?          @map("integration_id")
  configuration   Json             @default("{}")
  status          LeadSourceStatus @default(active)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("lead_sources")
}

model LeadImport {
  id                String           @id @default(cuid())
  organizationId    String           @map("organization_id")
  filename          String
  status            LeadImportStatus @default(pending)
  mapping           Json?
  duplicatePolicy   DuplicatePolicy  @default(skip) @map("duplicate_policy")
  totalRows         Int              @default(0) @map("total_rows")
  validRows         Int              @default(0) @map("valid_rows")
  importedRows      Int              @default(0) @map("imported_rows")
  skippedRows       Int              @default(0) @map("skipped_rows")
  failedRows        Int              @default(0) @map("failed_rows")
  errorReport       Json?            @map("error_report")
  rawPreview        Json?            @map("raw_preview")
  headers           Json?
  createdByUserId   String?          @map("created_by_user_id")
  startedAt         DateTime?        @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("lead_imports")
}

model LeadForm {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  publicId           String   @unique @map("public_id")
  name               String
  fields             Json     @default("[]")
  automation         Json     @default("{}")
  spamSettings       Json     @default("{}") @map("spam_settings")
  isActive           Boolean  @default(true) @map("is_active")
  submissionCount    Int      @default(0) @map("submission_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions  LeadFormSubmission[]

  @@index([organizationId])
  @@map("lead_forms")
}

model LeadFormSubmission {
  id          String   @id @default(cuid())
  leadFormId  String   @map("lead_form_id")
  payload     Json
  leadId      String?  @map("lead_id")
  ipHash      String?  @map("ip_hash")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  leadForm LeadForm @relation(fields: [leadFormId], references: [id], onDelete: Cascade)

  @@index([leadFormId, createdAt])
  @@map("lead_form_submissions")
}

model ReferralLink {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  code           String
  name           String?
  campaignMeta   Json     @default("{}") @map("campaign_meta")
  pipelineId     String?  @map("pipeline_id")
