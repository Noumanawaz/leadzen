model ProviderUsageEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  provider       String
  endpoint       String
  quantity       Int      @default(1)
  providerCost   Float?   @map("provider_cost")
  metadata       Json?
